# DeepSeek API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_OUTPUT_TOKENS=2048

# Generate a long random token and use the same value in NapCat.
ONEBOT_ACCESS_TOKEN=replace-with-a-long-random-token
BOT_HOST=127.0.0.1
BOT_PORT=3001

# Comma-separated QQ group IDs. The bot ignores every other group.
QQ_GROUP_IDS=123456789
BOT_SYSTEM_PROMPT=你是群里的 AI 助手，回答简洁、友好、准确。
BOT_CONTEXT_MESSAGES=30
BOT_CONTEXT_CHARS=24000
BOT_CONTEXT_IMAGES=4
BOT_GROUP_COOLDOWN_SECONDS=2
BOT_MAX_IMAGE_BYTES=10485760

DATA_DIR=data

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# Estimated USD per 1M tokens, not a substitute for the DeepSeek bill.
DEEPSEEK_PRICE_CACHE_HIT=0.006
DEEPSEEK_PRICE_CACHE_MISS=0.3
DEEPSEEK_PRICE_OUTPUT=1.2
